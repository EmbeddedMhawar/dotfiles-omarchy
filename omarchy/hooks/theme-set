#!/bin/bash

THEME_NAME=$1
THEME_DIR="$HOME/.config/omarchy/current/theme"
HELIX_THEME_DIR="$HOME/.config/helix/themes"
HELIX_CONFIG="$HOME/.config/helix/config.toml"

mkdir -p "$HELIX_THEME_DIR"

COLORS_FILE="$THEME_DIR/colors.toml"
if [ ! -f "$COLORS_FILE" ]; then
    echo "Error: colors.toml not found in $THEME_DIR"
    exit 1
fi

parse_color() {
    local key="$1"
    grep "^${key} " "$COLORS_FILE" | head -1 | sed -E 's/.*= *"?([^"]*)"?/\1/' | tr -d ' '
}

ACCENT=$(parse_color "accent")
CURSOR=$(parse_color "cursor")
FOREGROUND=$(parse_color "foreground")
BACKGROUND=$(parse_color "background")
SEL_BG=$(parse_color "selection_background")
SEL_FG=$(parse_color "selection_foreground")
COLOR0=$(parse_color "color0")
COLOR1=$(parse_color "color1")
COLOR2=$(parse_color "color2")
COLOR3=$(parse_color "color3")
COLOR4=$(parse_color "color4")
COLOR5=$(parse_color "color5")
COLOR6=$(parse_color "color6")
COLOR7=$(parse_color "color7")
COLOR8=$(parse_color "color8")

cat > "$HELIX_THEME_DIR/omarchy.toml" << EOF
# Auto-generated theme from omarchy - $THEME_NAME

"ui.text" = { fg = "fg" }
"ui.background" = { bg = "bg", fg = "fg" }
"ui.cursor" = { fg = "bg", bg = "cur" }
"ui.cursor.match" = { fg = "cur", modifiers = ["reversed"] }
"ui.cursor.primary" = { fg = "bg", bg = "cur" }
"ui.linenr" = { fg = "grey" }
"ui.linenr.selected" = { fg = "cur" }
"ui.selection" = { bg = "sel_bg", fg = "sel_fg" }
"ui.selection.match" = { bg = "sel_bg", fg = "sel_fg" }
"ui.statusline" = { fg = "sel_fg", bg = "sel_bg" }
"ui.statusline.inactive" = { fg = "grey", bg = "bg" }
"ui.popup" = { bg = "sel_bg", fg = "sel_fg" }
"ui.popup.info" = { fg = "sel_fg", bg = "sel_bg" }
"ui.help" = { fg = "sel_fg", bg = "sel_bg" }
"ui.highlight" = { fg = "bg", bg = "cur" }
"ui.virtual.ruler" = { bg = "sel_bg" }
"ui.virtual" = { fg = "grey" }
"ui.virtual.selection" = { bg = "sel_bg" }
"ui.menu" = { fg = "sel_fg", bg = "sel_bg" }
"ui.menu.selected" = { fg = "bg", bg = "cur" }
"ui.tooltip" = { fg = "sel_fg", bg = "sel_bg" }
"ui.tooltip.selected" = { fg = "bg", bg = "cur" }

"type" = { fg = "purple" }
"type.builtin" = { fg = "purple", modifiers = ["bold"] }
"constructor" = { fg = "purple" }
"constant" = { fg = "peach" }
"string" = { fg = "green" }
"number" = { fg = "peach" }
"comment" = { fg = "grey", modifiers = ["italic"] }
"variable" = { fg = "fg" }
"variable.builtin" = { fg = "peach", modifiers = ["bold"] }
"keyword" = { fg = "mauve" }
"keyword.directive" = { fg = "mauve", modifiers = ["italic"] }
"keyword.storage" = { fg = "red" }
"keyword.control" = { fg = "mauve" }
"operator" = { fg = "sky" }
"punctuation" = { fg = "fg" }
"tag" = { fg = "mauve" }
"attribute" = { fg = "peach" }
"namespace" = { fg = "peach" }
"function" = { fg = "accent" }
"function.builtin" = { fg = "accent", modifiers = ["bold"] }
"function.method" = { fg = "accent" }
"macro" = { fg = "mauve" }
"label" = { fg = "accent" }
"module" = { fg = "peach" }
"field" = { fg = "fg" }
"property" = { fg = "fg" }

"error" = { fg = "red", modifiers = ["bold"] }
"warning" = { fg = "yellow" }
"info" = { fg = "sky" }
"hint" = { fg = "grey" }
"diagnostic" = { fg = "red", modifiers = ["underlined"] }
"diagnostic.error" = { fg = "red" }
"diagnostic.warning" = { fg = "yellow" }
"diagnostic.info" = { fg = "sky" }
"diagnostic.hint" = { fg = "grey" }

[palette]
bg = "$BACKGROUND"
fg = "$FOREGROUND"
cur = "$CURSOR"
sel_bg = "$SEL_BG"
sel_fg = "$SEL_FG"
grey = "$COLOR8"
peach = "$COLOR7"
orange = "$COLOR7"
red = "$COLOR1"
mauve = "$COLOR5"
purple = "$COLOR4"
accent = "$ACCENT"
sky = "$COLOR6"
green = "$COLOR2"
yellow = "$COLOR3"
EOF

echo "Helix theme updated for omarchy theme: $THEME_NAME"
